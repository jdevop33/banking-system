# Copy to .env for docker-compose.prod.yml:  cp .env.example .env
# Secrets are RUNTIME env only — never commit .env and never bake it into an image.

# REQUIRED in production. Generate one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Leave at 0 in production. Set to 1 only for local debugging.
DEBUG=0

# Comma-separated public hostnames Django will serve (localhost/127.0.0.1 are always allowed).
#   ALLOWED_HOSTS=banking.example.com
ALLOWED_HOSTS=

# Needed when a login/form POST arrives over HTTPS through a reverse proxy (Caddy).
# Django 3.2 expects hostnames here, e.g.:  CSRF_TRUSTED_ORIGINS=banking.example.com
CSRF_TRUSTED_ORIGINS=

# The following are already set by docker-compose.prod.yml and normally need no override:
#   SQLITE_PATH=/data/db.sqlite3
#   STATIC_ROOT=/app/staticfiles
#   CELERY_BROKER_URL=redis://redis:6379/0
#   CELERY_RESULT_BACKEND=redis://redis:6379/0
